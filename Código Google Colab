def evaluar_credito(nombre, ingresos, historial, antiguedad_meses, deuda_total):
    score = 0
    razones = []
    
    # Regla 1: ingresos mensuales >= $25,000
    if ingresos >= 25000:
        score += 2
        razones.append("Ingresos suficientes")
    else:
        razones.append("Ingresos bajos")
        
    # Regla 2: historial crediticio
    if historial == "limpio":
        score += 2
        razones.append("Historial limpio")
    elif historial == "regular":
        score += 1
        razones.append("Historial con observaciones")
    else:
        razones.append("Historial negativo")
        
    # Regla 3: antigüedad laboral >= 12 meses
    if antiguedad_meses >= 12:
        score += 1
        razones.append("Antigüedad suficiente")
    else:
        razones.append("Antigüedad insuficiente")
        
    # Regla 4: deuda menor al 40% de los ingresos
    if deuda_total < ingresos * 0.40:
        score += 1
        razones.append("Deuda bajo control")
    else:
        razones.append("Nivel de deuda alto")
        
    if score >= 5:
        decision = "Aprobado"
    elif 3 <= score < 5:
        decision = "En revisión"
    else:
        decision = "Rechazado"
        
    print(f"\nEvaluación de {nombre}")
    print(f"Puntuación: {score}/6")
    print(f"Resultado: {decision}")
    for razon in razones:
        print(" -", razon)
        
    return decision

